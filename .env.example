# =============================================
# .env.example — Copy thành .env và điền giá trị thật
# =============================================

# ===== DATABASE =====
POSTGRES_DB=shopdb
POSTGRES_USER=shopuser
POSTGRES_PASSWORD=change-this-strong-password

SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/shopdb
SPRING_DATASOURCE_USERNAME=shopuser
SPRING_DATASOURCE_PASSWORD=change-this-strong-password

# ===== JWT =====
# Dùng: openssl rand -base64 64 để tạo secret ngẫu nhiên
JWT_SECRET=change-this-to-a-very-long-random-string-at-least-32-chars

# ===== FRONTEND URL (CORS) =====
# Local: localhost:3000
# Production: https://yourdomain.com
FRONTEND_URL=localhost:3000

# ===== EMAIL (Gmail App Password) =====
# Hướng dẫn tạo App Password: https://myaccount.google.com/apppasswords
MAIL_USERNAME=your-shop-email@gmail.com
MAIL_PASSWORD=your-gmail-app-password

# ===== AWS S3 (để upload ảnh sản phẩm) =====
AWS_ACCESS_KEY=your-aws-access-key-id
AWS_SECRET_KEY=your-aws-secret-access-key
AWS_S3_BUCKET=your-s3-bucket-name
AWS_REGION=ap-southeast-1

# ===== OAUTH2 (Đăng nhập Google, Facebook, Github) =====
# Tắt nếu không dùng, để placeholder nếu muốn giữ
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

FACEBOOK_CLIENT_ID=your-facebook-client-id
FACEBOOK_CLIENT_SECRET=your-facebook-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# ===== RECAPTCHA =====
RECAPTCHA_SECRET=your-recaptcha-secret-key
