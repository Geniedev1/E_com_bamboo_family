# ==== Cấu hình production cho rattanovi.com ====
# Sao chép thành .env (cùng thư mục docker-compose.prod.yml) rồi điền giá trị thật:
#   cp .env.prod.example .env   &&   nano .env
# Chạy: docker compose -f docker-compose.prod.yml --env-file .env up -d

# ----- PostgreSQL -----
POSTGRES_DB=shopdb
POSTGRES_USER=shopuser
POSTGRES_PASSWORD=CHANGE_ME_mat_khau_manh

# ----- JWT (chuỗi ngẫu nhiên dài, >= 32 ký tự) -----
JWT_SECRET=CHANGE_ME_chuoi_ngau_nhien_that_dai_va_bi_mat

# ----- Domain / CORS / OAuth redirect (có scheme https) -----
FRONTEND_URL=https://rattanovi.com

# ----- URL gốc cho ảnh admin upload (ảnh mẫu dùng /static/ nên không phụ thuộc biến này) -----
APP_BASE_URL=https://rattanovi.com

# ----- Thư mục lưu ảnh trong container (đã mount volume backend_uploads) -----
UPLOAD_DIR=/app/uploads

# ----- Email (Gmail App Password, KHÔNG dùng mật khẩu thường) -----
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-16-char-app-password

# ----- Google OAuth (tạo tại Google Cloud Console) -----
# Authorized redirect URI phải thêm: https://rattanovi.com/login/oauth2/code/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
